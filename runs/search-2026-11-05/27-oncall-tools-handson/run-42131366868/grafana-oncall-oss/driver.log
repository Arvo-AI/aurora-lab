STEP 1 download docker-compose.yml
$ curl -fsSL https://raw.githubusercontent.com/grafana-cold-storage/oncall/v1.16.11/docker-compose.yml -o docker-compose.yml
exit=0

STEP 2 write .env: DOMAIN, COMPOSE_PROFILES=with_grafana, SECRET_KEY
STEP 3 docker compose pull && docker compose up -d
