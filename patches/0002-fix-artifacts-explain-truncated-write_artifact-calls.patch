 .../chat/backend/agent/tools/artifact_tool.py | 26 +++++-
 .../chat/backend/agent/tools/cloud_tools.py   |  4 +-
 .../test_write_artifact_truncated_call.py     | 82 +++++++++++++++++++
 3 files changed, 108 insertions(+), 4 deletions(-)
